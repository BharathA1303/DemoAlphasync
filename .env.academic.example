# ==============================================================================
#  AlphaSync Academic — Deployment Environment Template
#  On the server:   cp .env.academic.example .env   and fill real values.
#  This .env is consumed by docker-compose.yml (project: acalphasync).
#  NEVER commit the real .env.
# ==============================================================================

# ── Compose identity (locks the project name so bare `docker compose` is safe) ─
COMPOSE_PROJECT_NAME=acalphasync

# ── Application ────────────────────────────────────────────────────────────────
APP_NAME=AlphaSync-Academic
APP_ENV=production
DEBUG=false
SIMULATION_MODE=true
DOMAIN=ac.alphasync.app
PUBLIC_URL=https://ac.alphasync.app

# ── PostgreSQL (internal to acalphasync-net only; NO host port) ───────────────
#  Use UNIQUE values — do NOT reuse AlphaSync Real or TickAlpha credentials.
POSTGRES_DB=alphasync_academic
POSTGRES_USER=alphasync_academic
POSTGRES_PASSWORD=CHANGE_ME_strong_unique_db_password

# ── Redis (internal only; NO host port) ───────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Security / Auth ────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_long_random_jwt_secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_DAYS=30

# ── Data Feed (TickAlpha) ──────────────────────────────────────────────────────
# Encrypts the admin-configured TickAlpha Client Secret at rest. The Client
# ID/Secret/base URL themselves are set later from the Admin Panel, not here.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DATA_FEED_ENCRYPTION_KEY=CHANGE_ME_strong_unique_data_feed_encryption_key

# ── CORS (production origin only) ─────────────────────────────────────────────
CORS_ORIGINS=["https://ac.alphasync.app"]
CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1):\d+

# ── Admin allowlist ────────────────────────────────────────────────────────────
ADMIN_EMAIL_ALLOWLIST=["admin@alphasync.app"]

# ── Twilio (optional) ─────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── AI / LLM keys (optional) ──────────────────────────────────────────────────
GROK_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
