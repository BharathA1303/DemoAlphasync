# ── AlphaSync Environment Configuration ─────────────────────────
# Copy this file to .env and fill in your values.

# ── Core ────────────────────────────────────────────────────────
APP_NAME=AlphaSync
# Keep DEBUG=false in any internet-facing environment.
# For localhost-only development you may set DEBUG=true.
DEBUG=false
DATABASE_URL=postgresql+asyncpg://alphasync:alphasync@localhost:5432/alphasync
DATA_FEED_ENCRYPTION_KEY=dev-data-feed-key-not-for-production-needs-32chars!!

# ── Firebase Authentication ─────────────────────────────────────
# Provide one of the following:
# FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=

# ── CORS ────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Redis (shared live price cache across all user sessions) ────
REDIS_URL=redis://localhost:6379/0

# ── TickAlpha Data Feed ──────────────────────────────────────────
# The TickAlpha Client ID/Secret and base URL are configured by an admin
# from the Admin Panel ("Data Feed" section), not via environment
# variables — they're stored (secret encrypted) in the database. No
# TickAlpha env vars are needed here; the platform falls back to the
# local simulator until an admin enables the live feed.

# ── Simulation ──────────────────────────────────────────────────
SIMULATION_MODE=true
# Dev-only override. Keep false to enforce market-hour trade blocking.
ALLOW_AFTER_HOURS_TRADING=false

# ── Admin Panel Security ────────────────────────────────────────
# JSON array of bootstrap admin emails
ADMIN_EMAIL_ALLOWLIST=["meganath1025@gmail.com"]

# ── SMTP (Account Notifications) ────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@alphasync.app
SMTP_FROM_NAME=AlphaSync
SMTP_USE_TLS=true
